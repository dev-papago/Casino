{
  "name": "casino-platform",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "카지노 플랫폼: 관리자 PC의 칩 장부 서버, 관리자 화면, 플레이어 화면 (같은 와이파이)",
  "author": "casion",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "vite build && node scripts/build-games.mjs",
    "server": "node src/server/main.ts",
    "start": "npm run build && node src/server/main.ts",
    "test": "vitest run",
    "e2e": "npm run build && playwright test",
    "typecheck": "tsc --noEmit",
    "exe": "npm run build && vite build --config vite.server.config.ts && electron-builder --win portable --x64 && electron-builder --config electron-builder.player.json --win portable --x64"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.5",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.casion.casinoledger",
    "productName": "CasinoLedger",
    "directories": {
      "output": "release"
    },
    "electronLanguages": [
      "ko",
      "en-US"
    ],
    "files": [
      "dist/**",
      "dist-server/server.mjs",
      "electron/main.cjs",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "CasinoLedger-${version}-portable.exe"
    }
  },
  "overrides": {
    "vite": "$vite"
  }
}
